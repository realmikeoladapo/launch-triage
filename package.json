{
  "name": "launch-triage",
  "version": "1.2.0",
  "description": "Static production-readiness triage for web and mobile codebases. Finds the defects that matter before launch, with evidence for every claim.",
  "bin": { "launch-triage": "scan.mjs" },
  "type": "module",
  "scripts": {
    "test": "node --test test/run.mjs",
    "example": "node test/generate-example.mjs",
    "prepublishOnly": "npm test"
  },
  "files": ["scan.mjs", "README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "examples/sample-report.md"],
  "keywords": ["security", "audit", "production-readiness", "nextjs", "supabase", "code-review", "static-analysis"],
  "author": "Mike Oladapo (https://mikeoladapo.com)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/realmikeoladapo/launch-triage.git" },
  "homepage": "https://github.com/realmikeoladapo/launch-triage#readme",
  "bugs": { "url": "https://github.com/realmikeoladapo/launch-triage/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" }
}
